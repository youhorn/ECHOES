    - target: {fileID: 4634812813110862758, guid: 92db6c4143f6d498d839550532e413be, type: 3}
      propertyPath: lines.Array.data[0].text
      value: "\uAE68\uC5B4\uB0AC\uAD6C\uB098, \uC5D0\uCF54. \uC774\uACF3\uC740 \uB124
        \uAE30\uC5B5\uC774 \uC7A0\uB4E0 \uACF5\uAC04\uC774\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 4634812813110862758, guid: 92db6c4143f6d498d839550532e413be, type: 3}
      propertyPath: lines.Array.data[1].text
      value: "\uC55E\uC758 \uBB38\uC740 \uC7A0\uACA8 \uC788\uB2E4. \uC774 \uC5F4\uC1E0\uB85C
        \uCCAB \uBC88\uC9F8 \uAE30\uC5B5\uC744 \uB530\uB77C\uAC00\uB77C."
      objectReference: {fileID: 0}
    - target: {fileID: 4634812813110862758, guid: 92db6c4143f6d498d839550532e413be, type: 3}
      propertyPath: lines.Array.data[2].text
      value: "\uAC00\uB77C. \uB108\uC758 \uCCAB \uC870\uAC01\uC774 \uC800 \uB108\uBA38\uC5D0
        \uC788\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 4634812813110862758, guid: 92db6c4143f6d498d839550532e413be, type: 3}
      propertyPath: lines.Array.data[0].speaker
      value: "\uAE30\uC5B5\uC9C0\uAE30"
