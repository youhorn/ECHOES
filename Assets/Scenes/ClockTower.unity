  speakerName: "\uC2DC\uACC4\uC9C0\uAE30"
  promptLines:
  - speaker: "\uC2DC\uACC4\uC9C0\uAE30"
    text: "\uC548\uB155\uD558\uC138\uC694? \uC800\uB294 \uC2DC\uACC4\uC9C0\uAE30
      \uC785\uB2C8\uB2E4."
  - speaker: "\uC5D0\uCF54"
    text: "(\uB418\uAC8C \uC608\uC758\uBC14\uB974\uB124)\n\uC548\uB155\uD558\uC138\uC694!
      \uC800\uB294 \uC800\uC758 \uC783\uC5B4\uBC84\uB9B0 \uAE30\uC5B5\uC744 \uCC3E\uACE0
      \uC788\uC5B4\uC694."
  - speaker: "\uC2DC\uACC4\uC9C0\uAE30"
    text: "\uB2F9\uC2E0\uC774\uAD70\uC694!"
  - speaker: "\uC5D0\uCF54"
    text: "\uC800\uB97C \uC544\uC138\uC694..?"
  - speaker: "\uC2DC\uACC4\uC9C0\uAE30"
    text: "\uC6B0\uB9AC\uB294 \uB2F9\uC2E0\uC744 \uC704\uD55C \uC874\uC7AC\uC785\uB2C8\uB2E4.
      \uB2F9\uC2E0\uC758 \uC783\uC5B4\uBC84\uB9B0 \uAE30\uC5B5\uC774 \uACE7 \uC6B0\uB9AC\uB4E4\uC774\uB77C\uACE0
      \uD560 \uC218 \uC788\uC8E0."
  - speaker: "\uC5D0\uCF54"
    text: "\uBB34\uC2A8 \uB9D0\uC778\uC9C0 \uC798 \uBAA8\uB974\uACA0\uC5B4\uC694..
      \uC800\uB97C \uC704\uD55C \uC874\uC7AC\uB77C\uBA74 \uC81C\uAC00 \uC65C \uC774\uACF3\uC5D0
      \uC788\uB294\uC9C0 \uC544\uC2DC\uB098\uC694? \uC800\uB294 \uC65C \uAE30\uC5B5\uC744
      \uC783\uC740\uAC70\uC8E0? \uC800\uB294 \uC65C \uC5EC\uAE30\uB85C \uC624\uAC8C
      \uB41C\uAC70\uC8E0? \uC800\uB294 \uBC84\uB824\uC9C4\uAC74\uAC00\uC694?"
  - speaker: "\uC2DC\uACC4\uC9C0\uAE30"
    text: "\uC9C4\uC815\uD558\uC138\uC694. \uC81C\uAC00 \uCC28\uADFC\uCC28\uADFC
      \uC124\uBA85\uD574\uB4DC\uB9AC\uC8E0."
  - speaker: "\uC2DC\uACC4\uC9C0\uAE30"
    text: "\uC5EC\uAE30\uB294 \uC5B4\uB460\uC758 \uD654\uC2E0 '\uBE14\uB7AD\uD06C'\uAC00
      \uC0AC\uB294 \uACF3\uC785\uB2C8\uB2E4."
  - speaker: "\uC5D0\uCF54"
    text: "\uC5B4\uB460\uC758 \uD654\uC2E0..?"
  - speaker: "\uC2DC\uACC4\uC9C0\uAE30"
    text: "\uC5B4\uB460\uC758 \uD654\uC2E0 \uBE14\uB7AD\uD06C\uB294 \uC601\uD63C,
      \uADF8\uB9AC\uACE0 \uAE30\uC5B5\uC744 \uBA39\uACE0 \uC790\uB77C\uC8E0.\n\uB2F9\uC2E0\uC758
      \uAE30\uC5B5\uB3C4 \uC544\uB9C8 \uBE14\uB7AD\uD06C\uAC00 \uAC00\uC838\uAC14\uC744\uAC81\uB2C8\uB2E4."
  - speaker: "\uC5D0\uCF54"
    text: "\uB0B4 \uAE30\uC5B5\uC744 \uB300\uCCB4 \uC65C..?"
  - speaker: "\uC2DC\uACC4\uC9C0\uAE30"
    text: "\uB204\uAD70\uAC00\uAC00 \uBE14\uB7AD\uD06C\uC640 \uAC70\uB798\uB97C \uD55C
      \uAC83 \uAC19\uC544\uC694.\n\uB204\uAD70\uAC00\uC758 \uAE30\uC5B5\uC744 \uAC00\uC838\uAC08
      \uC815\uB3C4\uC758 \uAC70\uB798\uBA74.. \uC790\uC2E0\uC758 \uC601\uD63C\uC744
      \uD314\uC558\uB098\uBCF4\uB124\uC694."
  - speaker: "\uC5D0\uCF54"
    text: "\uB300\uCCB4 \uB204\uAC00\uC694? \uC65C \uADF8\uB7F0 \uC9D3\uC744 \uD55C\uAC70\uC8E0?"
  - speaker: "\uC2DC\uACC4\uC9C0\uAE30"
    text: "\uD760.. \uADF8\uAC74 \uC800\uB3C4 \uC798 \uBAA8\uB974\uACA0\uB124\uC694.\n\uD558\uC9C0\uB9CC
      \uACF5\uAC04\uC774 \uB4A4\uD2C0\uB9AC\uACE0 \uC788\uC5B4\uC694.\n\uC81C \uC0DD\uAC01\uC5D4
      \uB2F9\uC2E0\uC758 \uAE30\uC5B5\uC774 \uC870\uAE08\uC529 \uC0C8\uC5B4\uB098\uAC00\uACE0
      \uC788\uB294 \uAC83 \uAC19\uC544\uC694."
  - speaker: "\uC2DC\uACC4\uC9C0\uAE30"
    text: "\uADF8\uB9AC\uACE0 \uADF8 \uAE30\uC5B5 \uC870\uAC01 \uC911 \uD558\uB098\uAC00
      \uBC14\uB85C \uC6B0\uB9AC\uB4E4 \uC785\uB2C8\uB2E4."
  - speaker: "\uC5D0\uCF54"
    text: "\uADF8\uB798\uC11C \uC800\uC5D0\uAC8C \uAE38\uC744 \uC54C\uB824\uC900\uAC70\uAD70\uC694?"
  - speaker: "\uC2DC\uACC4\uC9C0\uAE30"
    text: "\uADF8\uB807\uC8E0. \uC800 \uB610\uD55C, \uC81C\uAC00 \uB0B8 \uBB38\uC81C\uB97C
      \uB9DE\uCD98\uB2E4\uBA74 \uAE30\uC5B5\uC744 \uCC3E\uB294 \uB370 \uB3C4\uC6C0\uC744
      \uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4."
  - speaker: "\uC5D0\uCF54"
    text: "\uD574\uBCFC\uAC8C\uC694!"
  - speaker: "\uC2DC\uACC4\uC9C0\uAE30"
    text: "\uC774 \uC22B\uC790\uB4E4\uC740 \uBCF4\uD1B5 \uC22B\uC790\uAC00 \uC544\uB2C8\uB2E4.
      \uC544\uB798 \uADDC\uCE59\uC744 \uBCF4\uACE0 \uB9C8\uC9C0\uB9C9 \uB2F5\uC744
      \uB9D0\uD574\uB77C."
  - speaker: "\uC2DC\uACC4\uC9C0\uAE30"
    text: '1 = 2    2 = 5    3 = 5

      4 = 4    7 = 3    8 = ?'
  - speaker: "\uC2DC\uACC4\uC9C0\uAE30"
    text: "[E\uB85C \uC785\uB825 \uC2DC\uC791 \xB7 \uC22B\uC790\uD0A4 \uC785\uB825
      \xB7 Enter \uC81C\uCD9C \xB7 H \uD78C\uD2B8]"
  hintText: "\uC5B4\uB460 \uC18D\uC5D0\uC11C \uC22B\uC790\uB294 \uC77D\uD788\uC9C0
    \uC54A\uB294\uB2E4. \uB2E4\uB9CC, \uBA87 \uC870\uAC01\uC758 \uBE5B\uC73C\uB85C
    \uC790\uC2E0\uC744 \uB4DC\uB7EC\uB0BC \uBFD0\uC774\uC9C0."
  digitCount: 1
  correctCode: 7
  inputDisplay: {fileID: 0}
  normalColor: {r: 1, g: 1, b: 1, a: 1}
  wrongColor: {r: 1, g: 0.3, b: 0.3, a: 1}
  successCutscene:
  - speaker: "\uC2DC\uACC4\uC9C0\uAE30"
    text: "\uD56D\uC0C1 \uC870\uC2EC\uD558\uC138\uC694. \uBE14\uB7AD\uD06C\uB294
      \uC27D\uC9C0 \uC54A\uC740 \uC0C1\uB300\uC785\uB2C8\uB2E4."
  - speaker: "\uC5D0\uCF54"
    text: "\uAC10\uC0AC\uD569\uB2C8\uB2E4!"
  - speaker: 
    text: "\uAE30\uC5B5 \uC870\uAC01 'I'\uB97C \uC190\uC5D0 \uB123\uC5C8\uB2E4."
  rewardObject: {fileID: 0}
