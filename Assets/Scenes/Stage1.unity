      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 4634812813110862758, guid: 92db6c4143f6d498d839550532e413be, type: 3}
      propertyPath: lines.Array.size
      value: 10
      objectReference: {fileID: 0}
    - target: {fileID: 4634812813110862758, guid: 92db6c4143f6d498d839550532e413be, type: 3}
      propertyPath: lines.Array.data[0].text
      value: "\uAE68\uC5B4\uB0AC\uAD6C\uB098 \uC5D0\uCF54. \uC774\uACF3\uC740 \uB108\uC758
        \uAE30\uC5B5\uC774 \uC7A0\uB4E0 \uACF5\uAC04\uC774\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 4634812813110862758, guid: 92db6c4143f6d498d839550532e413be, type: 3}
      propertyPath: lines.Array.data[1].text
      value: "\uC800\uB97C \uC544\uC138\uC694..?\n\uC5EC\uAE34 \uC5B4\uB514\uACE0,
        \uC800\uB294 \uC65C \uAE30\uC5B5\uC744 \uC783\uC740\uAC70\uC8E0? \uC800\uB294
        \uBC84\uB824\uC9C4\uAC74\uAC00\uC694?"
      objectReference: {fileID: 0}
    - target: {fileID: 4634812813110862758, guid: 92db6c4143f6d498d839550532e413be, type: 3}
      propertyPath: lines.Array.data[2].text
      value: "\uB204\uAD70\uAC00\uAC00 \uB108\uC758 \uAE30\uC5B5\uC744 \uAC00\uC838\uAC14\uB098\uBCF4\uAD70.
        \uD558\uC9C0\uB9CC \uC5EC\uAE30\uB85C \uC628 \uAC78 \uBCF4\uB2C8, \uB108\uC5D0\uAC8C
        \uAE30\uD68C\uB97C \uC8FC\uC2E0 \uBAA8\uC591\uC774\uC57C."
      objectReference: {fileID: 0}
    - target: {fileID: 4634812813110862758, guid: 92db6c4143f6d498d839550532e413be, type: 3}
      propertyPath: lines.Array.data[3].text
      value: "\uADF8\uAC8C \uB204\uAD70\uAC00\uC694?"
      objectReference: {fileID: 0}
    - target: {fileID: 4634812813110862758, guid: 92db6c4143f6d498d839550532e413be, type: 3}
      propertyPath: lines.Array.data[4].text
      value: "\uB098\uB3C4 \uBAA8\uB978\uB2E4. \uD558\uC9C0\uB9CC \uB0B4 \uD2B9\uBCC4\uD788
        \uB108\uAC00 \uB9C8\uC74C\uC5D0 \uB4E4\uC5C8\uC73C\uB2C8, \uB108\uC5D0\uAC8C
        \uAE30\uC5B5\uC744 \uCC3E\uC744 \uC218 \uC788\uB3C4\uB85D \uB3C4\uC6C0\uC744
        \uC8FC\uC9C0."
      objectReference: {fileID: 0}
    - target: {fileID: 4634812813110862758, guid: 92db6c4143f6d498d839550532e413be, type: 3}
      propertyPath: lines.Array.data[5].text
      value: '!'
      objectReference: {fileID: 0}
    - target: {fileID: 4634812813110862758, guid: 92db6c4143f6d498d839550532e413be, type: 3}
      propertyPath: lines.Array.data[6].text
      value: "\uC55E\uC758 \uBB38\uC740 \uC7A0\uACA8\uC788\uB2E4. \uC774 \uC5F4\uC1E0\uB85C
        \uCCAB \uBC88\uC9F8 \uAE30\uC5B5\uC744 \uB530\uB77C\uAC00\uB77C."
      objectReference: {fileID: 0}
    - target: {fileID: 4634812813110862758, guid: 92db6c4143f6d498d839550532e413be, type: 3}
      propertyPath: lines.Array.data[7].text
      value: "\uAC10\uC0AC\uD569\uB2C8\uB2E4. \uADF8\uB7F0\uB370 \uB2F9\uC2E0\uC740
        \uB204\uAD6C\uC8E0?"
      objectReference: {fileID: 0}
    - target: {fileID: 4634812813110862758, guid: 92db6c4143f6d498d839550532e413be, type: 3}
      propertyPath: lines.Array.data[8].text
      value: ...
      objectReference: {fileID: 0}
    - target: {fileID: 4634812813110862758, guid: 92db6c4143f6d498d839550532e413be, type: 3}
      propertyPath: lines.Array.data[9].text
      value: "\uAC00\uB77C. \uB108\uC758 \uCCAB \uC870\uAC01\uC774 \uC800 \uB108\uBA38\uC5D0
        \uC788\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 4634812813110862758, guid: 92db6c4143f6d498d839550532e413be, type: 3}
