    - target: {fileID: 4634812813110862758, guid: 92db6c4143f6d498d839550532e413be, type: 3}
      propertyPath: speakerName
      value: "\uAE30\uC5B5\uC9C0\uAE30"
      objectReference: {fileID: 0}
    - target: {fileID: 4634812813110862758, guid: 92db6c4143f6d498d839550532e413be, type: 3}
      propertyPath: rewardMemoryId
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 4634812813110862758, guid: 92db6c4143f6d498d839550532e413be, type: 3}
      propertyPath: lines.Array.size
      value: 13
      objectReference: {fileID: 0}
    - target: {fileID: 4634812813110862758, guid: 92db6c4143f6d498d839550532e413be, type: 3}
      propertyPath: choices.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 4634812813110862758, guid: 92db6c4143f6d498d839550532e413be, type: 3}
      propertyPath: wrongLines.Array.size
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 4634812813110862758, guid: 92db6c4143f6d498d839550532e413be, type: 3}
      propertyPath: lines.Array.data[0].text
      value: "\uC5EC\uAE30\uAE4C\uC9C0 \uC654\uAD70. \uB108\uAC00 \uD574\uB0BC \uC904
        \uC54C\uC558\uC5B4."
      objectReference: {fileID: 0}
    - target: {fileID: 4634812813110862758, guid: 92db6c4143f6d498d839550532e413be, type: 3}
      propertyPath: lines.Array.data[1].text
      value: "\uB2F9\uC2E0\uC740 \uC544\uAE4C \uBD24\uB358!"
      objectReference: {fileID: 0}
    - target: {fileID: 4634812813110862758, guid: 92db6c4143f6d498d839550532e413be, type: 3}
      propertyPath: lines.Array.data[2].text
      value: "\uB098\uB97C \uAE30\uC5B5\uD558\uB2E4\uB2C8 \uAC10\uB3D9\uC774\uAD70."
      objectReference: {fileID: 0}
    - target: {fileID: 4634812813110862758, guid: 92db6c4143f6d498d839550532e413be, type: 3}
      propertyPath: lines.Array.data[3].text
      value: "\uC800 \uAE30\uC5B5\uC744 \uC870\uAE08\uC740 \uCC3E\uC740 \uAC83 \uAC19\uC544\uC694.\n\uC2DC\uACC4\uD0D1,
        \uC791\uACE0 \uC544\uB291\uD55C \uBC29.. \uADF8\uB9AC\uACE0 \uB204\uAD70\uAC00\uB97C
        \uADF8\uB9AC\uC6CC \uD558\uACE0 \uC788\uB294 \uAC83 \uAC19\uC544\uC694."
      objectReference: {fileID: 0}
    - target: {fileID: 4634812813110862758, guid: 92db6c4143f6d498d839550532e413be, type: 3}
      propertyPath: lines.Array.data[4].text
      value: "\uD558\uD558 \uB108\uC5D0\uAC8C \uAE38\uC744 \uC54C\uB824\uC900 \uBCF4\uB78C\uC774
        \uC788\uAD70."
      objectReference: {fileID: 0}
    - target: {fileID: 4634812813110862758, guid: 92db6c4143f6d498d839550532e413be, type: 3}
      propertyPath: lines.Array.data[5].text
      value: "\uB2F9\uC2E0\uC740 \uC800\uC758 \uAE30\uC5B5 \uC870\uAC01 \uC911 \uD558\uB098\uB77C\uACE0
        \uB4E4\uC5C8\uB294\uB370,\n\uC81C\uAC00 \uAE30\uC5B5\uC744 \uCC3E\uAC8C \uB418\uBA74
        \uB2F9\uC2E0\uC740 \uC5B4\uB5BB\uAC8C \uB418\uB294\uAC70\uC8E0?"
      objectReference: {fileID: 0}
    - target: {fileID: 4634812813110862758, guid: 92db6c4143f6d498d839550532e413be, type: 3}
      propertyPath: lines.Array.data[6].text
      value: "\uB108\uC758 \uC218\uB9CE\uC740 \uAE30\uC5B5 \uC911 \uD558\uB098\uAC00
        \uB418\uACA0\uC9C0."
      objectReference: {fileID: 0}
    - target: {fileID: 4634812813110862758, guid: 92db6c4143f6d498d839550532e413be, type: 3}
      propertyPath: lines.Array.data[7].text
      value: "\uC0AC\uB77C\uC9C0\uB294 \uAC74\uAC00\uC694..?"
      objectReference: {fileID: 0}
    - target: {fileID: 4634812813110862758, guid: 92db6c4143f6d498d839550532e413be, type: 3}
      propertyPath: lines.Array.data[8].text
      value: "\uC790\uB124\uAC00 \uB0A0 \uAE30\uC5B5\uD558\uACE0 \uC788\uB2E4\uBA74,
        \uB098\uB294 \uC0AC\uB77C\uC9C0\uC9C0 \uC54A\uC544.\n\uB108\uC758 \uAE30\uC5B5
        \uC911 \uD558\uB098\uB85C \uC0B4\uC544\uAC08\uAC70\uC57C."
      objectReference: {fileID: 0}
    - target: {fileID: 4634812813110862758, guid: 92db6c4143f6d498d839550532e413be, type: 3}
      propertyPath: lines.Array.data[9].text
      value: "...\n\uAF2D \uAE30\uC5B5\uD560\uAC8C\uC694.\n\uC774\uC81C \uC5B4\uB5BB\uAC8C
        \uD574\uC57C\uD558\uC8E0? \uBB38\uC81C\uB97C \uC8FC\uC138\uC694."
      objectReference: {fileID: 0}
    - target: {fileID: 4634812813110862758, guid: 92db6c4143f6d498d839550532e413be, type: 3}
      propertyPath: lines.Array.data[10].text
      value: "\uC5EC\uAE34 \uC5B4\uB460\uC758 \uD654\uC2E0\uC774 \uC788\uB294 \uACF3.\n\uB108\uC758
        \uAE30\uC5B5\uC740 \uC5B4\uB460\uC758 \uD654\uC2E0\uC774 \uAC16\uACE0 \uC788\uC9C0.\n\uC5B4\uB460\uC758
        \uD654\uC2E0\uC744 \uBB3C\uB9AC\uCE58\uBA74 \uBAA8\uB4E0 \uAE30\uC5B5\uC774
        \uB3CC\uC544\uC62C\uAC78\uC138."
      objectReference: {fileID: 0}
    - target: {fileID: 4634812813110862758, guid: 92db6c4143f6d498d839550532e413be, type: 3}
      propertyPath: lines.Array.data[11].text
      value: "\uADF8\uB807\uAD70\uC694.."
      objectReference: {fileID: 0}
    - target: {fileID: 4634812813110862758, guid: 92db6c4143f6d498d839550532e413be, type: 3}
      propertyPath: lines.Array.data[12].text
      value: "\uB450\uB835\uACA0\uC9C0. \uD558\uC9C0\uB9CC \uB9C8\uC8FC\uD574\uC57C\uB9CC
        \uAE30\uC5B5\uC744 \uB418\uCC3E\uC744 \uC218 \uC788\uC5B4."
      objectReference: {fileID: 0}
    - target: {fileID: 4634812813110862758, guid: 92db6c4143f6d498d839550532e413be, type: 3}
      propertyPath: choices.Array.data[0].text
      value: "\uB3C4\uC804\uD55C\uB2E4"
      objectReference: {fileID: 0}
    - target: {fileID: 4634812813110862758, guid: 92db6c4143f6d498d839550532e413be, type: 3}
      propertyPath: choices.Array.data[1].text
      value: "\uC544\uC9C1 \uC900\uBE44\uAC00 \uC548 \uB410\uB2E4"
      objectReference: {fileID: 0}
