--- !u!114 &825409343
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 825409341}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4c2e7f9a3d40f4f4e88a0e1567cb5b6e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  speakerName: 
  promptLines:
  - speaker: "\uB0A1\uC740 \uACC4\uC0B0\uAE30"
    text: "\uBC29 \uC548\uC5D0\uB294 \uC624\uB798\uB41C \uCC45\uC0C1, \uCC22\uC5B4\uC9C4
      \uC77C\uAE30\uC7A5, \uB0A1\uC740 \uACC4\uC0B0\uAE30\uAC00 \uC788\uB2E4."
  - speaker: "\uB0A1\uC740 \uACC4\uC0B0\uAE30"
    text: "\uC544\uB798 \uAE00\uC744 \uBCF4\uACE0, \uB124 \uC790\uB9AC \uC554\uD638\uB97C
      \uB9D0\uD574\uC918."
  - speaker: "\uB0A1\uC740 \uACC4\uC0B0\uAE30"
    text: "\uCC45\uC0C1 \uBC11\uC5D0 \uCC22\uC5B4\uC9C4 \uC77C\uAE30\uAC00 \uC788\uC5C8\uB2E4.\n\uBB38\uD2C8\uC5D0\uB294
      \uAC80\uC740 \uC774\uB07C\uAC00 \uB205\uB205\uD558\uAC8C \uBC88\uC838 \uC788\uC5C8\uB2E4.\n\uCC3D\uBB38
      \uB108\uBA38\uB85C \uD560\uC544\uBC84\uC9C0\uC758 \uC624\uB974\uACE8 \uC18C\uB9AC\uAC00
      \uD758\uB7EC\uB098\uC654\uB2E4.\n\uD560\uC544\uBC84\uC9C0\uB294 \uB098\uB97C
      \uBB34\uCC99 \uC0AC\uB791\uD558\uC2E0\uB2E4."
  - speaker: "\uB0A1\uC740 \uACC4\uC0B0\uAE30"
    text: "[E\uB85C \uC785\uB825 \uC2DC\uC791 \xB7 \uC22B\uC790\uD0A4 \uC785\uB825
      \xB7 Enter \uC81C\uCD9C \xB7 H \uD78C\uD2B8]"
  hintText: "\uB0A1\uC740 \uACC4\uC0B0\uAE30 \uC704\uB85C \uD76C\uBBF8\uD558\uAC8C
    \uC22B\uC790\uAC00 \uB5A0\uC624\uB978\uB2E4\u2026  1  2  5  4"
  digitCount: 4
  correctCode: 1254
  inputDisplay: {fileID: 0}
  normalColor: {r: 1, g: 1, b: 1, a: 1}
  wrongColor: {r: 1, g: 0.3, b: 0.3, a: 1}
  successCutscene:
  - speaker: 
    text: "\uB204\uAD70\uAC00\uC758 \uAE30\uC5B5\uC774 \uB5A0\uC624\uB978\uB2E4."
  - speaker: "\uD560\uC544\uBC84\uC9C0"
    text: "\uC5D0\uCF54, \uB098\uB294 \uB204\uAD6C\uBCF4\uB2E4 \uB110 \uC0AC\uB791\uD55C\uB2E8\uB2E4."
  - speaker: "\uAE30\uC5B5"
    text: "\uB204\uAD70\uAC00 \uCC45\uC0C1 \uC55E\uC5D0\uC11C \uACC4\uC0B0\uAE30\uB97C
      \uB450\uB4DC\uB9AC\uACE0 \uC788\uB2E4. \uC5D0\uCF54\uB294 \uADF8 \uC606\uC5D0\uC11C
      \uC77C\uAE30\uB97C \uC4F0\uACE0 \uC788\uB2E4. \uC624\uB974\uACE8 \uC18C\uB9AC\uAC00
      \uC791\uAC8C \uD750\uB978\uB2E4."
  - speaker: "\uC5D0\uCF54"
    text: "\uD560\uC544\uBC84\uC9C0, \uC808\uB300 \uB0B4 \uACC1\uC744 \uB5A0\uB098\uBA74
      \uC548 \uB3FC."
  - speaker: 
    text: "\uB178\uC778\uC740 \uC560\uC368 \uC6C3\uC73C\uBA70 \uACC4\uC0B0\uAE30\uB97C
      \uC870\uC6A9\uD788 \uB0B4\uB824\uB193\uB294\uB2E4."
  - speaker: 
    text: "\uAE30\uC5B5 \uC870\uAC01 \u2018my\u2019 \uB97C \uC190\uC5D0 \uB123\uC5C8\uB2E4."
  rewardObject: {fileID: 0}
  animateOnSolve: {fileID: 0}
  animateOffset: {x: 0, y: 0, z: 0}
  animateDuration: 1.5
  solveSfx: {fileID: 0}
  solveBgm: {fileID: 0}
